# Godot 4+ specific ignores
.godot/
/android/

# Local validation runtime, logs and maintenance helpers
.tools/

# Generated deliveries and temporary work; runtime assets remain versioned.
/exports/
/.tmp/
/godot.exe
/art-source/

# Editable character frames stay local; the game uses the generated sheets.
/assets/characters/*
!/assets/characters/sheets/
/assets/A_mouse_archer_in_simple-Idle/

# Local agent settings and credentials are not part of the game client.
/.agents/
/.codex/
.env
.env.*
!.env.example
.dev.vars*
*.pem
*.key

# Operating-system metadata.
.DS_Store
Thumbs.db
