{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guerra-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "RelayLobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayLobby"] }],
  "vars": { "ALLOWED_ORIGINS": "http://localhost:5173" },
  "observability": { "enabled": false }
}
