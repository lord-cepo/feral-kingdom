<mxCell id="ui" value="&lt;b&gt;Board presents valid targets&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hex highlight → click → unit menu if needed.&lt;br&gt;Players / off-board units use a button." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#E9F5EE;strokeColor=#3D8060;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="500" y="830" width="390" height="115" as="geometry"/></mxCell>
<mxCell id="e19" value="changed signal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="targets" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="choose" value="&lt;b&gt;PhraseSelection.choose(candidate)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Require a candidate with the same indices.&lt;br&gt;Set context.target; clear pending selection." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#EAF2FF;strokeColor=#3D68A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="500" y="1020" width="390" height="115" as="geometry"/></mxCell>
<mxCell id="e20" value="player chooses (even one target)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="ui" target="choose"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="execute" value="&lt;b&gt;Phrase.execute(context)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recheck source, subject, target and selectors.&lt;br&gt;Call verb(subject, target, ...user_params)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#EAF2FF;strokeColor=#3D68A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="500" y="1210" width="390" height="115" as="geometry"/></mxCell>
<mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="choose" target="execute"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="done" value="&lt;b&gt;Completion&lt;/b&gt;&lt;br&gt;&lt;br&gt;selection.finished(action_result)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#E9F5EE;strokeColor=#3D8060;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="500" y="1410" width="390" height="80" as="geometry"/></mxCell>
<mxCell id="e22" value="boolean result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="execute" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="selection" value="&lt;b&gt;What candidates() actually does&lt;/b&gt;&lt;br&gt;&lt;br&gt;Troople.all(kind)&lt;br&gt;→ discard invalid references&lt;br&gt;→ filter with selector.matches(t, context)&lt;br&gt;&lt;br&gt;DistanceSelector and QuerySelector inherit this method from Effect.Selector." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#EAF2FF;strokeColor=#3D68A1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="340" height="240" as="geometry"/></mxCell>
<mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;endArrow=open;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="selection" target="subjects"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="468"/><mxPoint x="440" y="360"/></Array></mxGeometry></mxCell>
<mxCell id="troople" value="Troople" style="swimlane;html=1;startSize=42;horizontal=1;rounded=0;collapsible=0;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#172B43;fillColor=#E9F5EE;swimlaneFillColor=#FFFFFF;strokeColor=#3D8060;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="735" width="340" height="250" as="geometry"/></mxCell>
<mxCell id="troople-body" value="&lt;div style=&quot;line-height:1.5&quot;&gt;ipl : player index&lt;br&gt;iun : index within that player's army&lt;br&gt;ihx : hex index&lt;hr&gt;-1 = absent field&lt;br&gt;ihx -2 = undeployed; -3 = defeated&lt;br&gt;valid(kind), same(other)&lt;br&gt;unit(), player(), hex()&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=15;fontColor=#172B43;" vertex="1" parent="troople"><mxGeometry x="0" y="42" width="340" height="208" as="geometry"/></mxCell>
<mxCell id="match" value="Match (autoload)" style="swimlane;html=1;startSize=42;horizontal=1;rounded=0;collapsible=0;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#172B43;fillColor=#E9F5EE;swimlaneFillColor=#FFFFFF;strokeColor=#3D8060;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="1070" width="340" height="210" as="geometry"/></mxCell>
<mxCell id="match-body" value="&lt;div style=&quot;line-height:1.5&quot;&gt;players : Dictionary[player_id, Player]&lt;br&gt;army : {1: [...], 2: [...]}&lt;br&gt;map : Array[HexInfo]&lt;hr&gt;Current storage: per-player armies;&lt;br&gt;no global unit index yet.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=15;fontColor=#172B43;" vertex="1" parent="match"><mxGeometry x="0" y="42" width="340" height="168" as="geometry"/></mxCell>
<mxCell id="e24" value="resolves references" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="troople" target="match"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cancel" value="&lt;b&gt;Cancellation / no candidates&lt;/b&gt;&lt;br&gt;&lt;br&gt;No candidates or Esc → cancel().&lt;br&gt;Clear state; changed; finished(false).&lt;br&gt;No action is executed." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FCEEEF;strokeColor=#B75761;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1000" y="185" width="320" height="145" as="geometry"/></mxCell>
<mxCell id="e25" value="0 subjects" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="subjects" target="cancel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="360"/><mxPoint x="940" y="294"/></Array></mxGeometry></mxCell>
<mxCell id="emptytarget" value="&lt;b&gt;No targets&lt;/b&gt;&lt;br&gt;&lt;br&gt;cancel() → finished(false)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FCEEEF;strokeColor=#B75761;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1000" y="660" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="e26" value="0 targets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="targets" target="emptytarget"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="invalid" value="&lt;b&gt;Invalid / stale choice&lt;/b&gt;&lt;br&gt;&lt;br&gt;Not in candidate list: ignore, keep waiting.&lt;br&gt;&lt;br&gt;Stale subject/target, failed validation or failed action: finish with false." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FCEEEF;strokeColor=#B75761;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1000" y="1020" width="320" height="175" as="geometry"/></mxCell>
<mxCell id="e27" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.35;" edge="1" parent="1" source="choose" target="invalid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="actions" value="&lt;b&gt;Actions own state changes and events&lt;/b&gt;&lt;br&gt;&lt;br&gt;deactivate: set active = false;&lt;br&gt;emit Match.deactivate(subject, target).&lt;br&gt;&lt;br&gt;fire: emit Match.fire(subject, target, D).&lt;br&gt;Damage application is not implemented." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#E9F5EE;strokeColor=#3D8060;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1000" y="1265" width="320" height="210" as="geometry"/></mxCell>
<mxCell id="e28" value="verb.function" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="execute" target="actions"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="scope" value="&lt;b&gt;Scope of this page&lt;/b&gt;&lt;br&gt;&lt;br&gt;One ConsequencePhrase only.&lt;br&gt;Cost payment and event scheduling are not part of this flow." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FFF4DE;strokeColor=#B98220;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="1360" width="340" height="115" as="geometry"/></mxCell>
<mxCell id="foot" value="Actual call chain: Board → PhraseSelection → Phrase → Action → Match signal. Game rules beyond the existing actions are not inferred." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="1540" width="1250" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="discussion" name="3 - Proposed direction (not implemented)"><mxGraphModel dx="1400" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1400" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;03 / Where the design discussion is heading&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontColor=#142C46;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1250" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="PROPOSED ONLY • These ideas are not implemented by this diagram. Ownership, identity, and selection are separate concerns." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="82" width="1250" height="48" as="geometry"/></mxCell>
<mxCell id="now" value="&lt;b&gt;Current implementation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Match.army[player][unit_index]&lt;br&gt;&lt;br&gt;Every subject and target is a Troople.&lt;br&gt;&lt;br&gt;Selectors return Array[Troople].&lt;br&gt;&lt;br&gt;Prop has name, value, increment and target category; no property selector yet." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#F2F4F7;strokeColor=#64748B;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="350" height="275" as="geometry"/></mxCell>
<mxCell id="global" value="&lt;b&gt;Discussed: one global unit array&lt;/b&gt;&lt;br&gt;&lt;br&gt;Match.units : Array[UnitInfo]&lt;br&gt;&lt;br&gt;A unique, stable index identifies each unit.&lt;br&gt;UnitInfo supplies player and location.&lt;br&gt;&lt;br&gt;Never infer combinations from independent owner, unit and hex lists." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FFF4DE;strokeColor=#B98220;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="510" y="170" width="350" height="275" as="geometry"/></mxCell>
<mxCell id="actual" value="&lt;b&gt;Discussed: select actual objects&lt;/b&gt;&lt;br&gt;&lt;br&gt;Examples: UnitInfo, HexInfo, Player, Prop.&lt;br&gt;&lt;br&gt;The verb receives the types it needs.&lt;br&gt;Property selection preserves its owner.&lt;br&gt;&lt;br&gt;Troople may remain useful as a source / location reference." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FFF4DE;strokeColor=#B98220;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="170" width="350" height="275" as="geometry"/></mxCell>
<mxCell id="e29" value="identity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#B98220;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="now" target="global"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e30" value="targets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#B98220;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="global" target="actual"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="props" value="&lt;b&gt;Property ownership&lt;/b&gt;&lt;br&gt;&lt;br&gt;Player.props / UnitInfo.props / HexInfo.props&lt;br&gt;&lt;br&gt;Each Prop instance belongs to one owner.&lt;br&gt;A name identifies a property kind; it may not uniquely identify an instance." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FFF4DE;strokeColor=#B98220;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="555" width="350" height="190" as="geometry"/></mxCell>
<mxCell id="propref" value="Possible PropRef" style="swimlane;html=1;startSize=42;horizontal=1;rounded=0;collapsible=0;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#172B43;fillColor=#FFF4DE;swimlaneFillColor=#FFFFFF;strokeColor=#B98220;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="510" y="555" width="350" height="190" as="geometry"/></mxCell>
<mxCell id="propref-body" value="&lt;div style=&quot;line-height:1.5&quot;&gt;owner : Player | UnitInfo | HexInfo&lt;br&gt;prop : Prop&lt;hr&gt;Conceptual union notation.&lt;br&gt;A hex-only version could be HexPropRef.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Helvetica;fontSize=15;fontColor=#172B43;" vertex="1" parent="propref"><mxGeometry x="0" y="42" width="350" height="148" as="geometry"/></mxCell>
<mxCell id="e31" value="owner" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#B98220;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="props" target="propref"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="counter" value="&lt;b&gt;Example: reduce player 2's counter&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select Match.players[2].props&lt;br&gt;→ filter prop.name == requested_name&lt;br&gt;→ choose that actual Prop instance&lt;br&gt;→ decrease its value&lt;br&gt;&lt;br&gt;Carry its owner if events need ownership." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FFF4DE;strokeColor=#B98220;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="555" width="350" height="190" as="geometry"/></mxCell>
<mxCell id="e32" value="select" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#B98220;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="propref" target="counter"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="bombtitle" value="&lt;b&gt;Example: “This bomb counter moves to that hex”&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=23;fontColor=#142C46;" vertex="1" parent="1"><mxGeometry x="60" y="835" width="1250" height="45" as="geometry"/></mxCell>
<mxCell id="origin" value="&lt;b&gt;Effect source / cause&lt;/b&gt;&lt;br&gt;&lt;br&gt;The unit (Troople) that caused the effect.&lt;br&gt;&lt;br&gt;Keep this in execution context." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FFF4DE;strokeColor=#B98220;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="930" width="350" height="155" as="geometry"/></mxCell>
<mxCell id="bomb" value="&lt;b&gt;Grammatical subject&lt;/b&gt;&lt;br&gt;&lt;br&gt;HexPropRef(current_hex, actual_bomb)&lt;br&gt;&lt;br&gt;The moving entity is the property." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FFF4DE;strokeColor=#B98220;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="510" y="930" width="350" height="155" as="geometry"/></mxCell>
<mxCell id="destination" value="&lt;b&gt;Target&lt;/b&gt;&lt;br&gt;&lt;br&gt;Destination HexInfo&lt;br&gt;&lt;br&gt;Validate destination and source ownership." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FFF4DE;strokeColor=#B98220;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="930" width="350" height="155" as="geometry"/></mxCell>
<mxCell id="e33" value="causes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#B98220;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="origin" target="bomb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e34" value="moves" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#B98220;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bomb" target="destination"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="move" value="&lt;b&gt;move_hex_prop(subject, target): move the same object&lt;/b&gt;&lt;br&gt;&lt;br&gt;Remove the bomb from old_hex.props → append it to destination.props.&lt;br&gt;Its counter and object identity survive the move. A global property registry is not required." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FFF4DE;strokeColor=#B98220;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="510" y="1170" width="800" height="115" as="geometry"/></mxCell>
<mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475569;labelBackgroundColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;strokeColor=#B98220;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="destination" target="move"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="decision" value="&lt;b&gt;Design choice still to settle&lt;/b&gt;&lt;br&gt;&lt;br&gt;Allow different subject types too?&lt;br&gt;This makes the bomb the subject while the initiating unit stays the effect source." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontSize=16;fontColor=#172B43;fillColor=#FFF4DE;strokeColor=#B98220;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="1170" width="350" height="115" as="geometry"/></mxCell>
<mxCell id="foot" value="Amber and dashed arrows = discussion, not shipped behavior. No game scripts were changed while drawing this document." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="1330" width="1250" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
